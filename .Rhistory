# ==============================================================================
# HISTORIAL DE ANÁLISIS EXPLORATORIO - LAB #1
# Proyecto: Análisis de Datos de Dengue y Adult Dataset
# ==============================================================================
# ------------------------------------------------------------------------------
# 1. CONFIGURACIÓN INICIAL
# ------------------------------------------------------------------------------
# Cargar bibliotecas necesarias
library(dplyr)
library(ggplot2)
# Establecer directorio de trabajo
setwd("/Users/macbookproroberto/Documents/lab-1_Analisis-_Exploratorio-")
# ------------------------------------------------------------------------------
# 2. ANÁLISIS DATASET ADULT (Income)
# ------------------------------------------------------------------------------
# 2.1. Visualización básica: Distribución de niveles educativos
ggplot(adult_data, aes(x = education)) +
geom_bar(fill = "skyblue", color = "black") +
theme_minimal() +
labs(title = "Distribution of Education Levels",
x = "Education Level",
y = "Count") +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
# 2.2. Exploración numérica: Income por nivel educativo
income_by_education <- adult_data %>%
group_by(education) %>%
summarise(
Total_Count = n(),
Income_Over_50K = sum(income == ">50K"),
Proportion_Over_50K = sum(income == ">50K") / n()
) %>%
arrange(desc(Proportion_Over_50K))
print("Proportion of Income >50K by Education Level:")
print(income_by_education)
# 2.3. Visualización gráfica: Proporción de Income por Education
ggplot(adult_data, aes(x = education, fill = income)) +
geom_bar(position = "fill", color = "black") +
scale_fill_manual(values = c("<=50K" = "salmon", ">50K" = "darkgreen")) +
theme_minimal() +
labs(title = "Proportion of Income Levels by Education",
x = "Education Level",
y = "Proportion",
fill = "Income") +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
# 2.4. Prueba Chi-Cuadrado: Independencia Education vs Income
contingency_table <- table(adult_data$education, adult_data$income)
print("Contingency Table (Education vs. Income):")
print(contingency_table)
chi_sq_test_result <- chisq.test(contingency_table)
print("\nChi-Squared Test Result:")
print(chi_sq_test_result)
print("\nExpected Frequencies:")
print(round(chi_sq_test_result$expected, 2))
print("\nStandardized Residuals (highlighting deviations from independence):")
print(round(chi_sq_test_result$stdres, 2))
# ------------------------------------------------------------------------------
# 3. ANÁLISIS DATASET DENGUE (Guatemala 2012-2023)
# ------------------------------------------------------------------------------
# 3.1. Lectura y limpieza del CSV
df <- read.csv(
"enfermedades-transmitidas-por-vectores-2012-al-2023-dengue.csv",
sep = ";",
skip = 6,
header = FALSE,
stringsAsFactors = FALSE,
encoding = "latin1"
)
# 3.2. Asignación de nombres de columnas
colnames(df) <- c(
"Ano", "Departamento", "Municipio", "Cantidad",
"lt1mes_F", "lt1mes_M",
"1m_2m_F", "1m_2m_M",
"2m_1a_F", "2m_1a_M",
"1a_4a_F", "1a_4a_M",
"5a_9a_F", "5a_9a_M",
"10a_14a_F", "10a_14a_M",
"15a_19a_F", "15a_19a_M",
"20a_24a_F", "20a_24a_M",
"25a_39a_F", "25a_39a_M",
"40a_49a_F", "40a_49a_M",
"50a_59a_F", "50a_59a_M",
"60a_64a_F", "60a_64a_M",
"65a_69a_F", "65a_69a_M",
"70a_plus_F", "70a_plus_M"
)
# 3.3. Conversión de columnas numéricas
cols_numeric <- setdiff(names(df), c("Ano", "Departamento", "Municipio"))
df[cols_numeric] <- lapply(df[cols_numeric], function(x) {
x <- trimws(x)
x[x == "-" | x == ""] <- NA
x <- gsub(",", "", x)
as.numeric(x)
})
df$Ano <- as.integer(df$Ano)
df$Cantidad <- as.integer(df$Cantidad)
# 3.4. Creación de variables agregadas
# Grupo de edad 5-39 años
cols_5_39 <- c("5a_9a_F", "5a_9a_M",
"10a_14a_F", "10a_14a_M",
"15a_19a_F", "15a_19a_M",
"20a_24a_F", "20a_24a_M",
"25a_39a_F", "25a_39a_M")
df$grupo_5_39 <- rowSums(df[, cols_5_39], na.rm = TRUE)
# Totales por sexo
cols_femenino <- grep("_F$", names(df), value = TRUE)
cols_masculino <- grep("_M$", names(df), value = TRUE)
df$femenino_total <- rowSums(df[, cols_femenino], na.rm = TRUE)
df$masculino_total <- rowSums(df[, cols_masculino], na.rm = TRUE)
# 3.5. Agregación por año
agg_year <- df %>%
group_by(Ano) %>%
summarise(
casos_totales   = sum(Cantidad, na.rm = TRUE),
casos_5_39      = sum(grupo_5_39, na.rm = TRUE),
femeninos       = sum(femenino_total, na.rm = TRUE),
masculinos      = sum(masculino_total, na.rm = TRUE)
) %>%
mutate(
prop_5_39       = casos_5_39 / casos_totales,
prop_femenino   = femeninos / (femeninos + masculinos)
)
# ------------------------------------------------------------------------------
# 4. VISUALIZACIONES DENGUE
# ------------------------------------------------------------------------------
# 4.1. Casos totales por año
ggplot(agg_year, aes(x = Ano, y = casos_totales)) +
geom_col() +
geom_text(aes(label = format(casos_totales, big.mark = ",")),
vjust = -0.3, size = 3) +
labs(
title = "Casos totales de dengue por año (Guatemala, 2012–2023)",
x     = "Año",
y     = "Número de casos"
) +
theme_minimal()
# 4.2. Proporción de casos en grupo 5-39 años
ggplot(agg_year, aes(x = Ano, y = prop_5_39)) +
geom_line() +
geom_point() +
geom_hline(yintercept = 0.5, linetype = "dashed") +
scale_y_continuous(labels = scales::percent_format(accuracy = 1)) +
labs(
title = "Proporción de casos de dengue en el grupo de 5–39 años",
x     = "Año",
y     = "Proporción de casos en 5–39 años"
) +
theme_minimal()
# 4.3. Proporción de casos en mujeres
ggplot(agg_year, aes(x = Ano, y = prop_femenino)) +
geom_line() +
geom_point() +
geom_hline(yintercept = 0.5, linetype = "dashed") +
scale_y_continuous(labels = scales::percent_format(accuracy = 1)) +
labs(
title = "Proporción de casos de dengue en mujeres",
x     = "Año",
y     = "Proporción de casos femeninos"
) +
theme_minimal()
# ------------------------------------------------------------------------------
# 5. PRUEBAS DE HIPÓTESIS
# ------------------------------------------------------------------------------
# 5.1. Prueba de proporción - Sexo
test_sexo <- prop.test(
x = female,
n = female + male,
p = 0.50,
alternative = "greater"
)
print(test_sexo)
# ==============================================================================
# 6. ANÁLISIS DE PREGUNTAS 4.6 - 4.10 (MOVIES DATASET)
# ==============================================================================
# Cargar datos de películas
movies <- read.csv("movies_2026.csv", stringsAsFactors = FALSE)
# Extraer género principal (primer género antes del |)
movies$genero_principal <- sapply(strsplit(movies$genres, "\\|"), function(x) {
if(length(x) > 0 && x[1] != "") return(x[1])
else return(NA)
})
# ------------------------------------------------------------------------------
# 4.6. Análisis de Géneros Cinematográficos
# ------------------------------------------------------------------------------
# a) Género de las 20 películas más recientes
top20_recientes <- movies %>%
arrange(desc(releaseDate)) %>%
head(20)
genero_recientes <- sort(table(top20_recientes$genero_principal), decreasing = TRUE)
print("Género en las 20 más recientes:")
print(genero_recientes)
# b) Género predominante en el dataset completo
genero_dataset <- sort(table(movies$genero_principal), decreasing = TRUE)
print("Top 10 géneros en el dataset:")
print(head(genero_dataset, 10))
# c) Género de las películas más largas
top_largas <- movies %>%
filter(runtime > 0) %>%
arrange(desc(runtime)) %>%
head(20)
genero_largas <- sort(table(top_largas$genero_principal), decreasing = TRUE)
print("Género de películas más largas:")
print(genero_largas)
# Gráfico 4.6: Distribución de géneros
par(mfrow = c(2, 2))
barplot(head(genero_dataset, 10), las = 2, col = "steelblue",
main = "Top 10 Géneros en el Dataset",
ylab = "Cantidad de Películas", cex.names = 0.7)
barplot(genero_recientes, las = 2, col = "coral",
main = "Géneros en las 20 Más Recientes",
ylab = "Cantidad", cex.names = 0.7)
barplot(genero_largas, las = 2, col = "mediumseagreen",
main = "Géneros en las 20 Más Largas",
ylab = "Cantidad", cex.names = 0.7)
# ------------------------------------------------------------------------------
# 4.7. Género con Mayores Ganancias
# ------------------------------------------------------------------------------
movies$ganancia <- movies$revenue - movies$budget
genero_ganancias <- movies %>%
filter(ganancia > 0, !is.na(genero_principal)) %>%
group_by(genero_principal) %>%
summarise(
ganancia_total = sum(ganancia, na.rm = TRUE),
ganancia_promedio = mean(ganancia, na.rm = TRUE),
n_peliculas = n()
) %>%
arrange(desc(ganancia_total))
print("Top 10 géneros con mayores ganancias totales:")
print(head(genero_ganancias, 10))
genero_ganancias_prom <- genero_ganancias %>%
filter(n_peliculas >= 10) %>%
arrange(desc(ganancia_promedio))
print("Top 10 géneros con mayores ganancias promedio (min 10 películas):")
print(head(genero_ganancias_prom, 10))
# Gráfico 4.7: Ganancias por género
par(mfrow = c(1, 2))
top10_ganancias <- head(genero_ganancias, 10)
barplot(top10_ganancias$ganancia_total / 1e9,
names.arg = top10_ganancias$genero_principal,
las = 2, col = "darkgreen",
main = "Top 10 Géneros - Ganancia Total",
ylab = "Ganancia (Miles de Millones $)",
cex.names = 0.7)
barplot(head(genero_ganancias_prom, 10)$ganancia_promedio / 1e6,
names.arg = head(genero_ganancias_prom, 10)$genero_principal,
las = 2, col = "gold",
main = "Top 10 Géneros - Ganancia Promedio",
ylab = "Ganancia Promedio (Millones $)",
cex.names = 0.7)
# ------------------------------------------------------------------------------
# 4.8. Influencia de la Cantidad de Actores
# ------------------------------------------------------------------------------
# Correlación cantidad de actores vs ingresos
cor_actores_revenue <- cor(movies$actorsAmount, movies$revenue,
use = "complete.obs")
print(paste("Correlación actores-ingresos:", round(cor_actores_revenue, 4)))
# Tendencia de actores por año
actores_por_año <- movies %>%
filter(releaseYear >= 1990, actorsAmount > 0) %>%
group_by(releaseYear) %>%
summarise(
promedio_actores = mean(actorsAmount, na.rm = TRUE),
mediana_actores = median(actorsAmount, na.rm = TRUE),
n_peliculas = n()
) %>%
arrange(releaseYear)
print("Últimos 10 años - promedio de actores:")
print(tail(actores_por_año, 10))
# Gráfico 4.8: Actores e ingresos
par(mfrow = c(1, 2))
plot(movies$actorsAmount, movies$revenue / 1e6,
xlab = "Cantidad de Actores", ylab = "Ingresos (Millones $)",
main = paste0("Actores vs Ingresos\nCorr: ", round(cor_actores_revenue, 3)),
pch = 16, col = rgb(0, 0, 1, 0.3))
abline(lm(revenue ~ actorsAmount, data = movies), col = "red", lwd = 2)
plot(actores_por_año$releaseYear, actores_por_año$promedio_actores,
type = "l", lwd = 2, col = "darkblue",
xlab = "Año", ylab = "Promedio de Actores",
main = "Evolución de Cantidad de Actores\n(1990-2026)")
points(actores_por_año$releaseYear, actores_por_año$promedio_actores,
pch = 16, col = "darkblue")
# ------------------------------------------------------------------------------
# 4.9. Influencia del Género del Reparto
# ------------------------------------------------------------------------------
cor_mujeres_pop <- cor(movies$castWomenAmount, movies$popularity, use = "complete.obs")
cor_hombres_pop <- cor(movies$castMenAmount, movies$popularity, use = "complete.obs")
cor_mujeres_rev <- cor(movies$castWomenAmount, movies$revenue, use = "complete.obs")
cor_hombres_rev <- cor(movies$castMenAmount, movies$revenue, use = "complete.obs")
print("Correlaciones con Popularidad:")
print(paste("Mujeres:", round(cor_mujeres_pop, 4)))
print(paste("Hombres:", round(cor_hombres_pop, 4)))
print("Correlaciones con Ingresos:")
print(paste("Mujeres:", round(cor_mujeres_rev, 4)))
print(paste("Hombres:", round(cor_hombres_rev, 4)))
# Gráfico 4.9: Género del reparto
par(mfrow = c(2, 2))
plot(movies$castWomenAmount, movies$popularity,
xlab = "Mujeres en Reparto", ylab = "Popularidad",
main = paste0("Mujeres vs Popularidad\nCorr: ", round(cor_mujeres_pop, 3)),
pch = 16, col = rgb(1, 0, 0, 0.3))
plot(movies$castMenAmount, movies$popularity,
xlab = "Hombres en Reparto", ylab = "Popularidad",
main = paste0("Hombres vs Popularidad\nCorr: ", round(cor_hombres_pop, 3)),
pch = 16, col = rgb(0, 0, 1, 0.3))
plot(movies$castWomenAmount, movies$revenue / 1e6,
xlab = "Mujeres en Reparto", ylab = "Ingresos (Millones $)",
main = paste0("Mujeres vs Ingresos\nCorr: ", round(cor_mujeres_rev, 3)),
pch = 16, col = rgb(1, 0, 0, 0.3))
plot(movies$castMenAmount, movies$revenue / 1e6,
xlab = "Hombres en Reparto", ylab = "Ingresos (Millones $)",
main = paste0("Hombres vs Ingresos\nCorr: ", round(cor_hombres_rev, 3)),
pch = 16, col = rgb(0, 0, 1, 0.3))
# ------------------------------------------------------------------------------
# 4.10. Directores de Películas Mejor Calificadas
# ------------------------------------------------------------------------------
top20_calificadas <- movies %>%
filter(voteCount >= 100, voteAvg > 0, director != "") %>%
arrange(desc(voteAvg)) %>%
head(20)
print("Top 20 películas mejor calificadas:")
print(select(top20_calificadas, title, director, voteAvg, voteCount))
directores_top <- sort(table(top20_calificadas$director), decreasing = TRUE)
print("Directores en Top 20:")
print(directores_top)
# Gráfico 4.10: Mejores películas y directores
par(mfrow = c(1, 2))
barplot(top20_calificadas$voteAvg[1:15],
names.arg = substr(top20_calificadas$title[1:15], 1, 15),
las = 2, col = "purple",
main = "Top 15 Películas Mejor Calificadas",
ylab = "Calificación Promedio", cex.names = 0.6)
if(length(directores_top) > 0) {
barplot(directores_top, las = 2, col = "orange",
main = "Directores en Top 20",
ylab = "Cantidad de Películas", cex.names = 0.7)
}
