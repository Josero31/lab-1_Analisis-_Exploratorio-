library(dplyr)
library(ggplot2)
agg_year <- df %>%
group_by(Anio) %>%
summarise(
casos_totales   = sum(Cantidad, na.rm = TRUE),
casos_5_39      = sum(grupo_5_39, na.rm = TRUE),
femeninos       = sum(femenino_total, na.rm = TRUE),
masculinos      = sum(masculino_total, na.rm = TRUE)
) %>%
mutate(
prop_5_39       = casos_5_39 / casos_totales,
prop_femenino   = femeninos / (femeninos + masculinos)
)
