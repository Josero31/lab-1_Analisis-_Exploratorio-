# 1. Stacked Bar Plot of Income by Education
# This plot will show the distribution of <=50K and >50K income for each education level.
ggplot(adult_data, aes(x = education, fill = income)) +
geom_bar(position = "fill", color = "black") + # 'position = "fill"' shows proportions
scale_fill_manual(values = c("<=50K" = "salmon", ">50K" = "darkgreen")) + # Custom colors
theme_minimal() +
labs(title = "Proportion of Income Levels by Education",
x = "Education Level",
y = "Proportion",
fill = "Income") +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) # Rotate labels for readability
# 1. Bar Plot of Education Levels
# This visualizes the frequency of each education level
ggplot(adult_data, aes(x = education)) +
geom_bar(fill = "skyblue", color = "black") +
theme_minimal() +
labs(title = "Distribution of Education Levels",
x = "Education Level",
y = "Count") +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) # Rotate labels for readability
# Load necessary libraries (if not already loaded)
library(dplyr)    # For data manipulation
library(ggplot2)  # For visualization
# --- Numerical Exploration: Income by Education Level ---
# 1. Group by education and calculate the proportion of ">50K" income for each level
income_by_education <- adult_data %>%
group_by(education) %>%
summarise(
Total_Count = n(),
Income_Over_50K = sum(income == ">50K"),
Proportion_Over_50K = sum(income == ">50K") / n()
) %>%
arrange(desc(Proportion_Over_50K)) # Order by proportion to easily see top education levels
print("Proportion of Income >50K by Education Level:")
print(income_by_education)
# --- Graphical Exploration: Income by Education Level ---
# 1. Stacked Bar Plot of Income by Education
# This plot will show the distribution of <=50K and >50K income for each education level.
ggplot(adult_data, aes(x = education, fill = income)) +
geom_bar(position = "fill", color = "black") + # 'position = "fill"' shows proportions
scale_fill_manual(values = c("<=50K" = "salmon", ">50K" = "darkgreen")) + # Custom colors
theme_minimal() +
labs(title = "Proportion of Income Levels by Education",
x = "Education Level",
y = "Proportion",
fill = "Income") +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) # Rotate labels for readability
# --- Chi-Squared Test of Independence between Education and Income ---
# 1. Create a contingency table (cross-tabulation) of education and income
contingency_table <- table(adult_data$education, adult_data$income)
print("Contingency Table (Education vs. Income):")
print(contingency_table)
# 2. Perform the Chi-Squared Test
chi_sq_test_result <- chisq.test(contingency_table)
print("\nChi-Squared Test Result:")
print(chi_sq_test_result)
# Additionally, let's look at the expected frequencies and residuals to understand
# which cells contribute most to the significance (if any)
print("\nExpected Frequencies:")
print(round(chi_sq_test_result$expected, 2))
print("\nStandardized Residuals (highlighting deviations from independence):")
print(round(chi_sq_test_result$stdres, 2))
