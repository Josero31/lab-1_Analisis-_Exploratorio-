# Lee todas las líneas del archivo
lineas <- readLines(ruta, encoding = "UTF-8")
# ------------------------------------------------------------------
# 2. Construir los nombres de columna a partir de las filas 5 y 6
# ------------------------------------------------------------------
h1 <- strsplit(lineas[5], ";")[[1]]  # "Año;Departamento;Municipio;Cantidad; < 1 mes;;1m a < 2m;;..."
h2 <- strsplit(lineas[6], ";")[[1]]  # ";;;;Femenino;Masculino;Femenino;Masculino;..."
# Función para "sanear" nombres (sin tildes, espacios, símbolos raros)
sanear <- function(x) {
x <- trimws(x)
x <- iconv(x, from = "UTF-8", to = "ASCII//TRANSLIT")  # quita tildes
x <- gsub(" ", "_", x)
x <- gsub("<", "lt", x)
x <- gsub("\\+", "plus", x)
x <- gsub("__+", "_", x)
x
}
# Primeras 4 columnas: Año, Departamento, Municipio, Cantidad
nombres <- sanear(h1[1:4])  # quedarán: "Ano", "Departamento", "Municipio", "Cantidad"
# Resto: grupos de edad X sexo
edades_brutas <- h1[-(1:4)]
sexos_brutos  <- h2[-(1:4)]
# "Forward-fill" de las edades (porque vienen como: "< 1 mes", "", "1m a < 2m", "", etc.)
edades_llenas <- character(length(edades_brutas))
edad_actual <- NA_character_
for (i in seq_along(edades_brutas)) {
e <- trimws(edades_brutas[i])
if (nzchar(e)) {
edad_actual <- e
}
edades_llenas[i] <- edad_actual
}
# Construir nombres para cada par edad–sexo
for (i in seq_along(edades_llenas)) {
edad_i <- edades_llenas[i]
sexo_i <- trimws(sexos_brutos[i])
if (!nzchar(sexo_i)) next  # saltar posiciones vacías
edad_clean <- sanear(edad_i)
sufijo_sexo <- ifelse(sexo_i == "Femenino", "F", "M")
nombres <- c(nombres, paste0(edad_clean, "_", sufijo_sexo))
}
length(nombres)  # debería ser 32
# ------------------------------------------------------------------
# 3. Leer la tabla de datos con esos nombres
# ------------------------------------------------------------------
# Saltamos las primeras 6 líneas (texto + encabezados)
lineas_datos <- lineas[-(1:6)]
# La primera de estas es "Todos los años;Todos los departamentos;..."
# que es un total agregado: la podemos eliminar
if (grepl("^Todos los años", lineas_datos[1])) {
lineas_datos <- lineas_datos[-1]
}
texto_datos <- paste(lineas_datos, collapse = "\n")
df <- read.csv2(
text = texto_datos,
header = FALSE,
col.names = nombres,
stringsAsFactors = FALSE
)
